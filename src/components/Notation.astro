---
interface Props {
    type?: string;
    color?: string;
    animate?: boolean;
    animationDelay?: number;
    animationDuration?: number;
    strokeWidth?: number;
    padding?: number;
    iterations?: number;
    className?: string;
    show?: boolean;
    brackets?: string[];
}

const {
    type = 'underline',
    color = '#000000',
    animate = true,
    animationDelay = 0,
    animationDuration = 800,
    strokeWidth = 3,
    padding = 5,
    iterations = 2,
    className = '',
    show = true,
    brackets
} = Astro.props;

const dataOptions = {
    type,
    color,
    animate,
    animationDelay,
    animationDuration,
    strokeWidth,
    padding,
    iterations,
    show,
    ...(brackets && { brackets })
};
---

<span class:list={['notation-target inline-block', className]} data-notation-options={JSON.stringify(dataOptions)}>
    <slot />
</span>

<script is:inline>
    (function () {
        let isLoading = false;
        let callbacks = [];
        // element -> annotation instance，保留引用以便布局位移后重绘定位
        const annotations = new Map();
        let refreshTimer = null;

        function loadRoughNotation(callback) {
            if (window.RoughNotation) {
                callback();
                return;
            }
            if (isLoading) {
                callbacks.push(callback);
                return;
            }
            isLoading = true;
            callbacks.push(callback);

            const script = document.createElement('script');
            script.src = 'https://unpkg.com/rough-notation@0.5.1/lib/rough-notation.iife.js';
            script.onload = function () {
                isLoading = false;
                callbacks.forEach(function (cb) {
                    cb();
                });
                callbacks = [];
            };
            script.onerror = function () {
                isLoading = false;
                callbacks = [];
                console.error('Failed to load Rough Notation');
            };
            document.head.appendChild(script);
        }

        function showAnnotation(el, opts) {
            let annotation = annotations.get(el);
            if (!annotation) {
                annotation = RoughNotation.annotate(el, opts);
                annotations.set(el, annotation);
            }
            if (opts.show) {
                // 对已显示的标注调用 show() 会无动画重绘，因此也用于重新定位
                annotation.show();
            }
        }

        function initNotations() {
            const elements = document.querySelectorAll('.notation-target[data-notation-options]:not([data-notation-initialized])');
            elements.forEach(function (el) {
                const opts = JSON.parse(el.dataset.notationOptions);
                showAnnotation(el, opts);
                el.dataset.notationInitialized = 'true';
            });
        }

        // 重绘已有标注，修正首次绘制后图片/字体加载造成的布局位移。
        // rough-notation 只在元素「尺寸」变化时重绘，不会响应「位置」变化。
        function refreshNotations() {
            if (refreshTimer) clearTimeout(refreshTimer);
            refreshTimer = setTimeout(function () {
                refreshTimer = null;
                document.querySelectorAll('.notation-target[data-notation-options][data-notation-initialized]').forEach(function (el) {
                    const annotation = annotations.get(el);
                    if (annotation) annotation.show();
                });
            }, 150);
        }

        // 等布局稳定（字体 + 图片加载完）再首次绘制，避免画在之后会被推移的位置上
        function whenStable() {
            const fontsReady = (document.fonts && document.fonts.ready) || Promise.resolve();
            const imagesReady = new Promise(function (resolve) {
                if (document.readyState === 'complete') resolve();
                else window.addEventListener('load', resolve, { once: true });
            });
            // 兜底：不让某个卡住的资源永远阻塞首次绘制
            const fallback = new Promise(function (resolve) {
                setTimeout(resolve, 1500);
            });
            return Promise.race([Promise.all([fontsReady, imagesReady]), fallback]);
        }

        function boot() {
            annotations.clear(); // view transition 切换页面后，元素是全新的
            loadRoughNotation(function () {
                whenStable().then(initNotations);
            });
        }

        // 监听懒加载图片的 load（load 不冒泡，需用 capture），首次绘制后再补正位移
        document.addEventListener(
            'load',
            function (e) {
                if (e.target && e.target.tagName === 'IMG') refreshNotations();
            },
            true
        );

        document.addEventListener('astro:after-swap', boot);

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', boot);
        } else {
            boot();
        }
    })();
</script>

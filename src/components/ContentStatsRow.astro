---
import { getCollection } from 'astro:content';
import { parseNotes, type ParsedNote } from '../utils/notes-parser';
import { sortPostsByDateDesc } from '../utils/post-utils';
import { countWords, formatWordCount } from '../utils/word-count';

interface StatItem {
    label: string;
    count: number;
    unit: string;
    /** 追加在数量后面的补充文字，如「文章」卡片的总字数 */
    suffix?: string;
    latest?: string;
    href: string;
}

// --- 随想 ---
const notesEntries = await getCollection('notes');
const allNotes: ParsedNote[] = [];
for (const entry of notesEntries) {
    const raw = typeof entry.body === 'string' ? entry.body : '';
    allNotes.push(...parseNotes(raw, entry.id));
}
allNotes.sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());
const notesLatest = allNotes[0]?.excerpt;

// --- 文章 ---
const posts = (await getCollection('blog')).filter(({ data }) => !data.draft).sort(sortPostsByDateDesc);
const blogLatest = posts[0]?.data.title;

// --- 写作总字数（已发布文章 + 随想）---
const totalWords = posts.reduce((sum, post) => sum + countWords(post.body ?? ''), 0) + allNotes.reduce((sum, note) => sum + countWords(note.rawContent), 0);

// --- 拾光 ---
const photos = (await getCollection('photography'))
    .filter(({ data }) => !data.draft)
    .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const shiguangLatest = photos[0]?.data.title;

const items: StatItem[] = [
    {
        label: '文章',
        count: posts.length,
        unit: '篇',
        suffix: `，${formatWordCount(totalWords)} 字`,
        latest: blogLatest,
        href: '/blog/'
    },
    {
        label: '拾光',
        count: photos.length,
        unit: '张',
        latest: shiguangLatest,
        href: '/shiguang/'
    },
    {
        label: '随想',
        count: allNotes.length,
        unit: '条',
        latest: notesLatest,
        href: '/notes/'
    }
];
---

<nav class="max-w-6xl mx-auto" aria-label="内容栏目">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {items.map((item) => (
            <a
                href={item.href}
                class="group rounded-xl border border-slate-200 bg-white px-5 py-4 transition-colors hover:border-primary dark:border-slate-700 dark:bg-slate-800/60"
            >
                <div class="flex items-baseline justify-between">
                    <h3 class="text-sm font-semibold tracking-wider text-slate-900 dark:text-slate-100">{item.label}</h3>
                    <span class="text-xs text-slate-400 dark:text-slate-500">
                        {item.count} {item.unit}
                        {item.suffix}
                    </span>
                </div>
                <p class="mt-1.5 truncate text-sm text-slate-500 dark:text-slate-400">{item.latest}</p>
            </a>
        ))}
    </div>
</nav>

---
import siteConfig from '../data/site-config';

type Props = { class?: string };

const { class: className } = Astro.props;
const config = siteConfig.forAgent;

if (!config?.enabled) {
    return;
}

const cardTitle = config.cardTitle ?? '让 AI Agent 帮你追更';
const cardText = config.cardText ?? '复制一段提示词给 Claude / ChatGPT，它就会定期检查本站有没有新内容，有更新时主动提醒你。';
const cardCta = config.cardCta ?? '前往配置';
---

<div
    class:list={[
        'w-full',
        'border border-violet-200/70 dark:border-violet-500/20',
        'rounded-xl',
        'bg-gradient-to-br from-violet-50 via-white to-indigo-50 dark:from-violet-950/30 dark:via-slate-900 dark:to-indigo-950/20',
        'shadow-sm hover:shadow-lg hover:border-violet-300 dark:hover:border-violet-500/40',
        'transition-all duration-300',
        className
    ]}
>
    <a href="/for-agent" class="block p-5 sm:p-6 group" aria-label={cardTitle}>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-start gap-4">
                <div
                    class="shrink-0 flex h-12 w-12 items-center justify-center rounded-xl text-2xl shadow-md shadow-violet-500/30 transition-transform group-hover:scale-105 bg-gradient-to-br from-violet-500 to-indigo-600"
                    aria-hidden="true"
                >
                    🤖
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">{cardTitle}</h2>
                        <span class="rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-violet-700 dark:bg-violet-900/40 dark:text-violet-300">
                            NEW
                        </span>
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{cardText}</p>
                </div>
            </div>
            <div class="flex shrink-0 items-center gap-2 self-end sm:self-center">
                <span class="text-sm font-semibold text-violet-700 dark:text-violet-300 group-hover:text-violet-800 dark:group-hover:text-violet-200">
                    {cardCta}
                </span>
                <span
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300 transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                >
                    →
                </span>
            </div>
        </div>
    </a>
</div>

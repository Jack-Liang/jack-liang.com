---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPostList from '../../components/BlogPostList.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPostsByDateDesc } from '../../utils/post-utils';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const allPosts = (await getCollection('blog'))
        .filter(({ data }) => !data.draft)
        .sort(sortPostsByDateDesc);

    return paginate(allPosts, { pageSize: siteConfig.postsPerPage || 5 });
}

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> };

// 标签云：取前 10 个高频标签
const allPosts = (await getCollection('blog')).filter(({ data }) => !data.draft);
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
    (post.data.tags ?? []).forEach((tag) => {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    });
});
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);

// 随机一篇的文章清单
const randomPostUrls = allPosts.map((post) => `/blog/${post.id}/`);
---

<BaseLayout title="文章" description="ABAP 开发、技术与思考的长文记录">
    <main data-pagefind-ignore class="px-4 py-12 grow sm:px-8 sm:py-16">
        <div class="max-w-6xl mx-auto mb-10 sm:mb-14">
            <h1 class="after:bg-primary text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl after:mt-4 after:block after:h-px after:w-16 after:content-['']">
                文章
            </h1>
            <p class="mt-4 text-slate-500 dark:text-slate-400">
                ABAP 开发、技术与思考的长文记录。
            </p>
        </div>

        <BlogPostList
            posts={page.data}
            tags={topTags}
            currentPage={page.currentPage}
            pageCount={page.lastPage}
            prevUrl={page.url.prev}
            nextUrl={page.url.next}
            randomPostUrls={randomPostUrls}
        />
    </main>

    <script is:inline>
        // 兼容旧的客户端筛选/分页链接：/?tag=X、/?page=N → 对应静态页
        (function () {
            const params = new URLSearchParams(window.location.search);
            const tag = params.get('tag');
            const pageNo = parseInt(params.get('page') || '', 10);
            if (tag) {
                window.location.replace(`/blog/tag/${encodeURIComponent(tag)}/`);
            } else if (pageNo > 1) {
                window.location.replace(`/blog/${pageNo}/`);
            }
        })();
    </script>
</BaseLayout>

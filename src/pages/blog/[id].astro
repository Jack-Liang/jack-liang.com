---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Comments from '../../components/Comments.astro';
import CustomImage from '../../components/CustomImage.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Subscribe from '../../components/Subscribe.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPostsByDateDesc } from '../../utils/post-utils';

export async function getStaticPaths() {
    const posts = (await getCollection('blog')).sort(sortPostsByDateDesc);
    const postCount = posts.length;
    return posts.map((post, index) => ({
        params: { id: post.id },
        props: {
            post,
            prevPost: index + 1 !== postCount ? posts[index + 1] : null,
            nextPost: index !== 0 ? posts[index - 1] : null
        }
    }));
}

const { href } = Astro.url;
const { post, prevPost, nextPost } = Astro.props as { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'>; nextPost: CollectionEntry<'blog'> };
const { title, publishDate, updatedDate, featureImage, excerpt, isFeatured, tags, seo } = post.data;
const { Content, headings } = await render(post);

// 侧边目录：只取 h2/h3，且至少 3 个标题才有展示价值
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 预计阅读时长：中文按 350 字/分钟，英文按 200 词/分钟
const bodyText = post.body ?? '';
const cjkChars = (bodyText.match(/[\u4e00-\u9fff]/g) ?? []).length;
const latinWords = (bodyText.replace(/[\u4e00-\u9fff]/g, ' ').match(/[a-zA-Z]+/g) ?? []).length;
const readingMinutes = Math.max(1, Math.round(cjkChars / 350 + latinWords / 200));

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    datePublished: publishDate.toISOString(),
    dateModified: (updatedDate ?? publishDate).toISOString(),
    author: { '@type': 'Person', name: siteConfig.title },
    image: featureImage?.src ? new URL(String(featureImage.src), Astro.site).toString() : undefined,
    mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(href, Astro.site).toString() },
    keywords: tags && tags.length > 0 ? tags.join(', ') : undefined
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image ?? { src: `/og/${post.id}.png`, alt: title }} pageType="article">
    <main class="px-4 py-12 grow sm:px-8 sm:py-16">
        <div
            id="reading-progress"
            aria-hidden="true"
            class="fixed inset-x-0 top-0 z-50 h-[3px] origin-left bg-primary dark:bg-primary-dark"
            style="transform: scaleX(0)"
        ></div>
        <article class="relative max-w-6xl mx-auto mb-12 sm:mb-16">
            <div class="max-w-3xl mx-auto mb-6">
                <a
                    href="/blog/"
                    class="inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 transition-colors duration-300 hover:bg-slate-100 hover:text-primary dark:bg-slate-800 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-700 dark:hover:text-primary-dark"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    返回文章
                </a>
            </div>
            <header class="max-w-3xl mx-auto mb-6 sm:mb-8">
                <div class="mb-3 text-sm tracking-wider uppercase text-slate-500 dark:text-slate-400">
                    {
                        isFeatured && (
                            <>
                                <span class="text-primary">Featured</span>
                                {' / '}
                            </>
                        )
                    }
                    <FormattedDate date={publishDate} />
                    {' · '}
                    <span>约 {readingMinutes} 分钟</span>
                    {
                        updatedDate && (
                            <>
                                {' '}
                                <span>
                                    (Updated on <FormattedDate date={updatedDate} />)
                                </span>
                            </>
                        )
                    }
                </div>
                <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100 sm:text-4xl md:text-5xl">{title}</h1>
                {
                    tags && tags.length > 0 && (
                        <div class="mt-4 flex flex-wrap gap-2">
                            {tags.map((tag) => (
                                <a
                                    href={`/blog/tag/${tag}/`}
                                    class="px-2 py-1 text-xs font-medium rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-primary hover:border-primary hover:text-white transition-colors dark:bg-slate-700 dark:border-slate-600 dark:text-slate-300 dark:hover:bg-primary dark:hover:border-primary dark:hover:text-white"
                                >
                                    {tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </header>
            {
                featureImage?.src && (
                    <figure class="my-6 sm:my-8 lg:my-12">
                        <div class="aspect-video w-full overflow-hidden rounded-lg">
                            <CustomImage
                                {...featureImage}
                                class="h-full w-full"
                                loading="eager"
                                fetchpriority="high"
                                widths={[480, 640, 768, 960, 1200, 1600]}
                                sizes="(min-width: 1216px) 1152px, calc(100vw - 32px)"
                            />
                        </div>
                        {featureImage.caption && <figcaption class="mt-1.5 text-xs sm:text-sm">{featureImage.caption}</figcaption>}
                    </figure>
                )
            }
            <div class="relative max-w-3xl mx-auto">
                <div class="prose prose-slate sm:prose-lg max-w-none">
                    <Content />
                </div>
                {
                    tocItems.length >= 3 && (
                        <nav aria-label="目录" class="hidden xl:block absolute top-0 bottom-0 left-full ml-6 w-40 print:hidden">
                            <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pb-4">
                                <p class="mb-3 text-xs font-semibold tracking-wider uppercase text-slate-400 dark:text-slate-500">目录</p>
                                <ul class="space-y-1.5 border-l border-slate-200 dark:border-slate-700">
                                    {tocItems.map((h) => (
                                        <li>
                                            <a
                                                href={`#${h.slug}`}
                                                data-toc-link
                                                class:list={[
                                                    '-ml-px block border-l-2 border-transparent py-0.5 text-[13px] leading-snug text-slate-500 transition-colors hover:text-primary dark:text-slate-400 dark:hover:text-primary-dark toc-link',
                                                    h.depth === 3 && 'pl-6',
                                                    h.depth === 2 && 'pl-3 font-medium text-slate-600 dark:text-slate-300'
                                                ]}
                                            >
                                                {h.text}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </nav>
                    )
                }
                <!-- <div class="flex flex-wrap mt-8 text-sm gap-x-3 gap-y-1 sm:mt-12 sm:text-base">
                    <span class="font-semibold">Share:</span>
                    <a
                        class="transition duration-300 text-primary hover:text-slate-700"
                        href={`https://bsky.app/intent/compose?text=${encodeURIComponent(title + ' ' + href)}`}
                        target="_blank"
                        rel="noopener noreferer"
                        aria-label="Share on Bluesky">Bluesky</a
                    >
                    <a
                        class="transition duration-300 text-primary hover:text-slate-700"
                        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(href)}&text=${encodeURIComponent(title)}`}
                        target="_blank"
                        rel="noopener noreferer"
                        aria-label="Share on X">X/Twitter</a
                    >
                    <a
                        class="transition duration-300 text-primary hover:text-slate-700"
                        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(href)}`}
                        target="_blank"
                        rel="noopener noreferer"
                        aria-label="Share on Facebook">Facebook</a
                    >
                    <a
                        class="transition duration-300 text-primary hover:text-slate-700"
                        href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(href)}&summary=${encodeURIComponent(title)}`}
                        target="_blank"
                        rel="noopener noreferer"
                        aria-label="Share on LinkedIn">LinkedIn</a
                    >
                </div> -->
            </div>
        </article>
        {
            (prevPost || nextPost) && (
                <div class="max-w-3xl mx-auto mb-12 sm:mb-16">
                    <h2 class="after:bg-primary mb-8 text-sm tracking-wider text-slate-900 uppercase after:mt-4 after:block after:h-px after:w-16 after:content-[''] sm:mb-12">
                        继续阅读
                    </h2>
                    <div class="grid gap-4 sm:grid-cols-2">
                        {prevPost && (
                            <a
                                href={`/blog/${prevPost.id}/`}
                                class="group rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-lg dark:border-slate-700 dark:bg-slate-800/60"
                            >
                                <p class="text-xs tracking-wider uppercase text-slate-400 dark:text-slate-500">&larr; 上一篇</p>
                                <p class="mt-2 line-clamp-2 font-semibold text-slate-900 transition-colors group-hover:text-primary dark:text-slate-100 dark:group-hover:text-primary-dark">
                                    {prevPost.data.title}
                                </p>
                                <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
                                    <FormattedDate date={prevPost.data.publishDate} />
                                </p>
                            </a>
                        )}
                        {nextPost && (
                            <a
                                href={`/blog/${nextPost.id}/`}
                                class="group rounded-xl border border-slate-200 bg-white p-5 transition-shadow hover:shadow-lg dark:border-slate-700 dark:bg-slate-800/60 sm:text-right"
                            >
                                <p class="text-xs tracking-wider uppercase text-slate-400 dark:text-slate-500">下一篇 &rarr;</p>
                                <p class="mt-2 line-clamp-2 font-semibold text-slate-900 transition-colors group-hover:text-primary dark:text-slate-100 dark:group-hover:text-primary-dark">
                                    {nextPost.data.title}
                                </p>
                                <p class="mt-2 text-xs text-slate-400 dark:text-slate-500">
                                    <FormattedDate date={nextPost.data.publishDate} />
                                </p>
                            </a>
                        )}
                    </div>
                </div>
            )
        }
        <Subscribe class="mt-16 mb-12 sm:mt-24 sm:mb-16" />
        <Comments />

    </main>
    <style is:global>
        /* 目录当前小节高亮（链接元素由客户端脚本动态加类） */
        .toc-link {
            border-left-color: transparent;
        }
        .toc-link.toc-active {
            border-left-color: #02738f;
            color: #02738f;
        }
        .dark .toc-link.toc-active {
            border-left-color: #38b2c8;
            color: #38b2c8;
        }

        /* 代码块复制按钮：注入到每个 pre 内 */
        .prose pre {
            position: relative;
        }
        .code-copy-btn {
            position: absolute;
            top: 0.6rem;
            right: 0.6rem;
            padding: 0.15rem 0.55rem;
            font-size: 0.72rem;
            line-height: 1.4;
            border-radius: 0.45rem;
            color: #d8dee9;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.16);
            opacity: 0.55;
            transition: opacity 0.2s, background 0.2s;
            cursor: pointer;
        }
        .prose pre:hover .code-copy-btn {
            opacity: 1;
        }
        .code-copy-btn:hover {
            background: rgba(255, 255, 255, 0.18);
        }
    </style>
    <script>
        // 目录滚动高亮：滚动时取视口顶部之上最近的标题
        let tocItems: { link: HTMLAnchorElement; heading: HTMLElement }[] = [];

        function refreshToc() {
            const links = [...document.querySelectorAll('[data-toc-link]')] as HTMLAnchorElement[];
            tocItems = links
                .map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
                .filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => !!item.heading);
            highlightToc();
        }

        function highlightToc() {
            if (tocItems.length === 0) return;
            let current = tocItems[0];
            for (const item of tocItems) {
                if (item.heading.getBoundingClientRect().top <= 120) current = item;
            }
            for (const { link } of tocItems) {
                link.classList.toggle('toc-active', link === current.link);
            }
        }

        // 阅读进度条：整页滚动进度，scaleX 变换驱动
        function updateProgressBar() {
            const bar = document.getElementById('reading-progress');
            if (!bar) return;
            const total = document.documentElement.scrollHeight - window.innerHeight;
            const progress = total > 0 ? Math.min(1, window.scrollY / total) : 0;
            bar.style.transform = `scaleX(${progress})`;
        }

        let tocTick = false;
        document.addEventListener('scroll', () => {
            if (tocTick) return;
            tocTick = true;
            requestAnimationFrame(() => {
                highlightToc();
                updateProgressBar();
                tocTick = false;
            });
        }, { passive: true });

        // 复制工具：Clipboard API 失败时回退 execCommand（兼容非安全上下文）
        async function copyText(text: string): Promise<boolean> {
            try {
                await navigator.clipboard.writeText(text);
                return true;
            } catch {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                let ok = false;
                try {
                    ok = document.execCommand('copy');
                } catch {
                    ok = false;
                }
                ta.remove();
                return ok;
            }
        }

        // 代码块一键复制：给每个 prose 内的 pre 注入按钮
        function bindCopyButtons() {
            document.querySelectorAll('.prose pre').forEach((pre) => {
                if (pre.dataset.copyBound) return;
                pre.dataset.copyBound = '1';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'code-copy-btn';
                btn.textContent = '复制';
                btn.addEventListener('click', async () => {
                    const code = pre.querySelector('code')?.innerText ?? pre.innerText ?? '';
                    btn.textContent = (await copyText(code)) ? '已复制' : '复制失败';
                    setTimeout(() => {
                        btn.textContent = '复制';
                    }, 1800);
                });
                pre.appendChild(btn);
            });
        }

        refreshToc();
        bindCopyButtons();
        updateProgressBar();
        document.addEventListener('astro:page-load', () => {
            refreshToc();
            bindCopyButtons();
            updateProgressBar();
        });
    </script>
</BaseLayout>

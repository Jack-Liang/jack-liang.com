---
import { getCollection } from 'astro:content';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).filter(({ data }) => !data.draft);
const randomPostUrls = posts.map((post) => `/blog/${post.id}/`);

const tagCounts = new Map<string, number>();
posts.forEach((post) => {
    (post.data.tags ?? []).forEach((tag) => {
        tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
    });
});
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6);
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动">
    <main class="px-4 py-20 grow sm:py-28">
        <div class="max-w-xl mx-auto text-center">
            <p class="text-7xl font-bold text-slate-200 dark:text-slate-700 select-none sm:text-8xl">404</p>
            <h1 class="mt-6 text-2xl font-bold text-slate-900 dark:text-slate-100 sm:text-3xl">这个页面不存在</h1>
            <p class="mt-4 text-slate-500 dark:text-slate-400">
                不是所有的路径都有尽头，也不是所有的尽头都有内容。
            </p>

            <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
                <a
                    href="/"
                    class="bg-primary hover:shadow-button inline-flex items-center justify-center rounded-full px-6 py-2.5 font-semibold text-white transition duration-300"
                >
                    返回首页
                </a>
                <button
                    id="random-post-btn"
                    data-posts={JSON.stringify(randomPostUrls)}
                    class="inline-flex items-center gap-2 rounded-full bg-white border border-slate-200 px-6 py-2.5 font-medium text-slate-600 transition-colors duration-300 hover:bg-primary hover:border-primary hover:text-white dark:bg-slate-800 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-[#38b2c8] dark:hover:border-[#38b2c8] dark:hover:text-white"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="4"></rect>
                        <circle cx="8.2" cy="8.2" r="1.2" fill="currentColor" stroke="none"></circle>
                        <circle cx="15.8" cy="8.2" r="1.2" fill="currentColor" stroke="none"></circle>
                        <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"></circle>
                        <circle cx="8.2" cy="15.8" r="1.2" fill="currentColor" stroke="none"></circle>
                        <circle cx="15.8" cy="15.8" r="1.2" fill="currentColor" stroke="none"></circle>
                    </svg>
                    随机读一篇
                </button>
            </div>

            {
                topTags.length > 0 && (
                    <div class="flex flex-wrap items-center justify-center gap-2 mt-10">
                        <span class="text-sm text-slate-400 dark:text-slate-500">或者逛逛：</span>
                        {topTags.map(([tag, count]) => (
                            <a
                                href={`/blog/tag/${tag}/`}
                                class="px-3 py-1.5 text-sm font-medium rounded-full bg-white border border-slate-200 text-slate-600 hover:bg-primary hover:border-primary hover:text-white transition-colors dark:bg-slate-800 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-[#38b2c8] dark:hover:border-[#38b2c8] dark:hover:text-white"
                            >
                                {tag} <span class="ml-1 text-xs opacity-70">({count})</span>
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </main>
</BaseLayout>

<script>
    import { navigate } from 'astro:transitions/client';

    document.getElementById('random-post-btn')?.addEventListener('click', () => {
        try {
            const btn = document.getElementById('random-post-btn');
            const urls = JSON.parse(btn?.dataset.posts || '[]');
            if (urls.length > 0) {
                navigate(urls[Math.floor(Math.random() * urls.length)]);
            }
        } catch {
            // 清单解析失败时按钮不动作
        }
    });
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CustomImage from '../../components/CustomImage.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const photos = (await getCollection('photography', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout title="拾光 | Jack Liang" description="Jack Liang 的拾光专栏：拾起光影，也拾起被留住的时间。">
    <div class="relative border-b border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50" slot="header">
        <Header class="relative" />
    </div>

    <main class="py-12 grow sm:py-16">
        <div class="px-4 sm:px-8">
            <div class="max-w-6xl mx-auto mb-10 sm:mb-14">
                <h1 class="after:bg-primary text-3xl font-bold text-slate-900 dark:text-white sm:text-4xl after:mt-4 after:block after:h-px after:w-16 after:content-['']">
                    拾光
                </h1>
                <p class="mt-4 text-slate-500 dark:text-slate-400">
                    把光影一张张拾起来。这里放着我这些年拍下的照片，和它们背后的故事。
                </p>
            </div>

            <div class="max-w-6xl mx-auto">
                {
                    photos.length === 0 ? (
                        <p class="text-slate-500 dark:text-slate-400">照片整理中，敬请期待。</p>
                    ) : (
                        <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
                            {photos.map((photo) => (
                                <a
                                    href={`/shiguang/${photo.id}/`}
                                    class="group mb-4 block break-inside-avoid overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 transition-shadow hover:shadow-lg"
                                >
                                    <div class="relative">
                                        <CustomImage
                                            {...photo.data.image}
                                            class="w-full transition-transform duration-500 group-hover:scale-[1.03]"
                                            widths={[400, 640, 900]}
                                            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/70 via-black/0 to-black/0 opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                                        <div class="pointer-events-none absolute inset-x-0 bottom-0 p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                                            <h2 class="text-lg font-semibold text-white">{photo.data.title}</h2>
                                            {photo.data.location && (
                                                <p class="mt-0.5 text-sm text-white/80">{photo.data.location}</p>
                                            )}
                                        </div>
                                    </div>
                                    <div class="flex items-center justify-between px-4 py-3">
                                        <h2 class="truncate text-sm font-medium text-slate-700 dark:text-slate-200">
                                            {photo.data.title}
                                        </h2>
                                        <time class="ml-3 shrink-0 text-xs text-slate-400 dark:text-slate-500">
                                            <FormattedDate date={photo.data.publishDate} />
                                        </time>
                                    </div>
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
        </div>
    </main>
</BaseLayout>
